{
  "expo": {
    "name": "Jinja Collection",
    "slug": "jinja-collection",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "jinjacollection",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.villainclement.jinjacollection",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "DZGF8CAR26"
    },
    "android": {
      "package": "com.villainclement.jinjacollection",
      "adaptiveIcon": {
        "backgroundColor": "#d63b23",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jinja Collection utilise ta position pour te guider jusqu'aux sanctuaires et te montrer où tu es sur la carte."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jinja Collection a besoin d'accéder à tes photos pour que tu partages une photo d'un sanctuaire.",
          "cameraPermission": "Jinja Collection a besoin de l'appareil photo pour que tu photographies un sanctuaire.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/lato/400Regular/Lato_400Regular.ttf",
            "./node_modules/@expo-google-fonts/lato/700Bold/Lato_700Bold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "apiBase": "https://jinja-collection.vercel.app",
      "googleWebClientId": "972771617767-ksfrnnnck9o8jhvif4cce60uoghrtv1o.apps.googleusercontent.com"
    }
  }
}
